# Copy this file to .env and replace every CHANGE_ME value before starting.
APP_ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=nethealth-api
API_VERSION_PREFIX=/api/v1

POSTGRES_DB=nethealth
POSTGRES_ADMIN_USER=nethealth_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_UNIQUE_ADMIN_PASSWORD
POSTGRES_MIGRATION_USER=nethealth_migrator
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_UNIQUE_MIGRATION_PASSWORD
DATABASE_USER=nethealth_app
DATABASE_PASSWORD=CHANGE_ME_UNIQUE_APPLICATION_PASSWORD
DATABASE_POOL_SIZE=5

REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_UNIQUE_REDIS_PASSWORD

AUTH_COOKIE_NAME=nethealth_session
AUTH_SESSION_HOURS=8
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_CORS_ORIGINS=["http://127.0.0.1:3000"]
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

SIMULATOR_MODE=true
COLLECTOR_PROFILES_JSON={}
COLLECTOR_REACHABILITY_SECONDS=30
COLLECTOR_HEALTH_SECONDS=60
COLLECTOR_INTERFACES_SECONDS=60
COLLECTOR_OPTICAL_SECONDS=180
COLLECTOR_INVENTORY_SECONDS=1800
ICMP_PROBE_ATTEMPTS=3
SYSLOG_ENABLED=false
SYSLOG_BIND_HOST=127.0.0.1
SYSLOG_PORT=5514

# TimescaleDB retention. Daily aggregates intentionally have no expiry.
METRICS_RAW_RETENTION_DAYS=30
METRICS_FIVE_MINUTE_RETENTION_DAYS=180
METRICS_HOURLY_RETENTION_DAYS=730
CORRELATION_WINDOW_SECONDS=60
